---
import type { Bill, BillStatus } from "@/lib/types";
import { COSPONSORSHIPS_BY_BILL } from "@/data/cosponsors";
import { BILLS_BY_ID } from "@/data/bills/all-bills";

interface Props {
  bill: Bill;
}
const { bill } = Astro.props;
const successor = bill.succeededBy ? BILLS_BY_ID.get(bill.succeededBy) : null;

// Originating memos that the card should credit ("Originally circulated
// as Senate Memo 48019"). We pull these from the bill's priorVersions
// list and keep only the entries that are memos in our tracked set —
// because succeeded memos no longer get their own bill card on the
// index, this is where their lineage is preserved.
const priorMemos = (bill.priorVersions ?? [])
  .map((id) => BILLS_BY_ID.get(id))
  .filter((b): b is NonNullable<typeof b> => !!b && b.kind === "memo");

/** Committee names use "and" in palegis / statute. Swap for "&" so the
 *  full name fits comfortably next to the chamber prefix ("Passed Senate
 *  Urban Affairs & Housing" vs the wordier "and Housing"). */
const shortCommittee = (name: string | undefined): string | null =>
  name ? name.replace(/ and /g, " & ") : null;

/** Chamber-aware status label so "Passed Senate" reads clearly
 *  instead of the ambiguous "Passed chamber". Names the specific
 *  committee when we know it (in_committee / passed_committee). */
const statusLabel = (
  status: BillStatus,
  chamber: "House" | "Senate",
  committee?: string,
): string => {
  const otherChamber = chamber === "Senate" ? "House" : "Senate";
  const cmte = shortCommittee(committee);
  switch (status) {
    case "memo": return "Cosponsorship memo";
    case "introduced": return "Introduced";
    case "in_committee":
      return cmte
        ? `In ${chamber} ${cmte}`
        : `In ${chamber} committee`;
    case "passed_committee":
      return cmte
        ? `Passed ${chamber} ${cmte}`
        : `Passed ${chamber} committee`;
    case "laid_on_table": return "Laid on the table";
    case "passed_2nd_consideration": return `Passed ${chamber} 2nd consideration`;
    case "passed_chamber": return `Passed ${chamber}`;
    case "other_chamber": return `In ${otherChamber}`;
    case "conference": return "In conference";
    case "enacted": return "Enacted";
    case "dead": return "Dead (last session)";
  }
};

const STATUS_TONE: Record<BillStatus, "active" | "warm" | "stalled" | "dead"> = {
  memo: "stalled",
  introduced: "stalled",
  in_committee: "stalled",
  passed_committee: "warm",
  laid_on_table: "warm",
  passed_2nd_consideration: "active",
  passed_chamber: "active",
  other_chamber: "active",
  conference: "active",
  enacted: "active",
  dead: "dead",
};

const isHistorical = bill.session === "2023-2024";
const tone = STATUS_TONE[bill.status];
const cs = COSPONSORSHIPS_BY_BILL.get(bill.id);
const sponsor = cs?.primeSponsor.name ?? null;
const coCount = cs?.cosponsors.length ?? 0;
const anchorId = `bill-${bill.id.toLowerCase()}`;
---

<article
  id={anchorId}
  class={`bill-card bill-card--${tone}${isHistorical ? " bill-card--historical" : ""}${successor ? " bill-card--superseded" : ""}`}
>
  <header class="bill-card__header">
    <div class="bill-card__title">
      <strong>{bill.label}</strong>{" "}
      <span
        class={`bill-card__shortTitle${isHistorical ? " bill-card__shortTitle--historical" : ""}`}
      >
        {bill.shortTitle}
      </span>
      {successor && (
        <span class="bill-card__superseded-tag">
          Introduced as{" "}
          <a href={`#bill-${successor.id.toLowerCase()}`}>{successor.label} ↓</a>
        </span>
      )}
    </div>
    <div class="bill-card__chips">
      <span class={`bill-card__status bill-card__status--${tone}`}>
        {statusLabel(bill.status, bill.chamber, bill.committee)}
      </span>
      <span class="bill-card__chamber">
        {bill.chamber}
        {isHistorical ? " · 2023-24" : ""}
      </span>
    </div>
  </header>
  <p class="bill-card__description">{bill.description}</p>
  {priorMemos.length > 0 && (
    <p class="bill-card__lineage">
      Originally circulated as{" "}
      {priorMemos.map((m, i) => (
        <>
          {i > 0 && ", "}
          {m.sourceUrl ? (
            <a href={m.sourceUrl} target="_blank" rel="noopener">
              {m.label}
            </a>
          ) : (
            m.label
          )}
        </>
      ))}
      .
    </p>
  )}
  <dl class="bill-card__meta">
    {sponsor && (
      <div>
        <dt>Prime sponsor</dt>
        <dd>
          {sponsor}
          {isHistorical && (
            <span class="bill-card__then-rep"> (then-rep)</span>
          )}
        </dd>
      </div>
    )}
    {coCount > 0 && (
      <div>
        <dt>Cosponsors</dt>
        <dd>{coCount}</dd>
      </div>
    )}
    {bill.lastActionNote && (
      <div class="bill-card__action">
        <dt>Most recent action</dt>
        <dd>{bill.lastActionNote}</dd>
      </div>
    )}
  </dl>
  <p class="bill-card__links">
    {bill.sourceUrl && (
      <a href={bill.sourceUrl} target="_blank" rel="noopener">
        Bill page on palegis.us
      </a>
    )}
    {bill.billTextUrl && (
      <>
        {" · "}
        <a href={bill.billTextUrl} target="_blank" rel="noopener">
          Full bill text (PDF)
        </a>
      </>
    )}
    {" · "}
    <a href={`?bill=${bill.id}#map`}>View on the map &uarr;</a>
  </p>
</article>
