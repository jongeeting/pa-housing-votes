---
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Where every PA House and Senate member stands on housing affordability legislation — vote tracker and cosponsor map for current and historical bills.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <footer class="page-footer">
      <p>
        Built by the PA Housing Choices Coalition. Source on
        <a href="https://github.com/jongeeting/pa-housing-votes">GitHub</a>.
      </p>
    </footer>
  </body>
</html>
