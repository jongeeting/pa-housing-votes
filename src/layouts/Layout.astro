---
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Where every PA House and Senate member stands on housing affordability legislation — vote tracker and cosponsor map for current and historical bills.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="site-nav" aria-label="Primary">
      <div class="site-nav__inner">
        <a class="site-nav__brand" href="/">PA Housing Votes</a>
        <ul class="site-nav__links">
          <li><a href="/#map">Map</a></li>
          <li><a href="/#bills">Bills</a></li>
          <li><a href="/housing-stats">Housing stats</a></li>
          <li><a href="/take-action">Take Action</a></li>
        </ul>
      </div>
    </nav>
    <slot />
    <footer class="page-footer">
      <p class="page-footer__brand-line">Brought to you by</p>
      <a
        class="footer-bpn"
        href="https://buildphillynow.substack.com"
        target="_blank"
        rel="noopener"
        aria-label="Build Philly Now"
      >
        <img
          src="/bpn-logo.svg"
          alt="Build Philly Now"
          class="footer-bpn__logo"
          width="160"
          height="61"
        />
      </a>
      <p class="page-footer__github">
        Source on
        {" "}
        <a href="https://github.com/jongeeting/pa-housing-votes">GitHub</a>.
      </p>
    </footer>
  </body>
</html>
