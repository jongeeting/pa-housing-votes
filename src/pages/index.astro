---
import Layout from "@/layouts/Layout.astro";
import { VoteMap } from "@/components/VoteMap";
import BillCard from "@/components/BillCard.astro";
import { ALL_MAP_ITEMS } from "@/data/mapItems";
import { ALL_BILLS } from "@/data/bills/all-bills";
import { groupBillsByTopic } from "@/lib/billGroups";

// Split current vs past-session bills so the index leads with what's
// actually moving. Past-session bills live in their own section at the
// bottom — they're useful as geographic context for where coalitions
// can be rebuilt, not as bills to track.
//
// Memos that have been succeeded by an introduced bill (succeededBy
// points to a tracked bill) don't get their own card — the lineage
// shows up inside the successor bill's card instead. The memo is
// still in ALL_BILLS so it remains in the map dropdown.
const trackedBillIds = new Set(ALL_BILLS.map((b) => b.id));
const isSucceededMemo = (b: typeof ALL_BILLS[number]) =>
  b.kind === "memo"
  && !!b.succeededBy
  && trackedBillIds.has(b.succeededBy);

const currentBills = ALL_BILLS.filter(
  (b) => b.session === "2025-2026" && !isSucceededMemo(b),
);
const pastBills = ALL_BILLS.filter(
  (b) => b.session === "2023-2024" && !isSucceededMemo(b),
);
const currentGroups = groupBillsByTopic(currentBills);
const pastGroups = groupBillsByTopic(pastBills);
---

<Layout title="PA Housing Votes — Zoning reform tracker">
  <header class="page-header">
    <div class="page-header__inner">
      <h1>
        Where every PA House and Senate member stands on housing
        affordability legislation
      </h1>
      <p class="page-header__lede">
        The Pennsylvania legislature is considering an unprecedented
        number of bipartisan bills this session to get more housing
        built and make a dent in the Commonwealth&rsquo;s 130,000-unit
        housing shortage. Select bills and explore the map to see where
        every member stands on current and past legislation, including
        committee votes, co-sponsorship memos, and more.
      </p>
    </div>
  </header>

  <main id="map" class="page-main">
    <VoteMap client:only="react" items={ALL_MAP_ITEMS} />
  </main>

  <section id="bills" class="page-notes bills-section">
    <h2>PA&rsquo;s pro-housing bills and where they stand</h2>
    {currentGroups.map((g) => (
      <div class="bills-topic">
        <h3 class="bills-topic__title">{g.topicLabel}</h3>
        <div class="bills-grid">
          {g.bills.map((bill) => <BillCard bill={bill} />)}
        </div>
      </div>
    ))}

    {pastGroups.length > 0 && (
      <div class="bills-past-section">
        <h2 id="bills-past">Bills from past sessions</h2>
        <p class="bills-section__lede">
          These bills moved through committees in the 2023&ndash;24
          session but ran out of clock. We include them here, and on the
          map, because their cosponsor and vote patterns illustrate the
          potential universe of supporters — geographic political
          patterns over time often predict where coalitions can be
          rebuilt this session.
        </p>
        {pastGroups.map((g) => (
          <div class="bills-topic">
            <h3 class="bills-topic__title">{g.topicLabel}</h3>
            <div class="bills-grid">
              {g.bills.map((bill) => <BillCard bill={bill} />)}
            </div>
          </div>
        ))}
      </div>
    )}

    <h2>Reading the map</h2>
    <ul>
      <li>
        <strong>Fill color</strong> shows how that district&rsquo;s
        legislator engaged with the selected bill. Green = Yea, orange =
        Nay, purple = sponsor or cosponsor, gray = no record.
      </li>
      <li>
        <strong>Outline color</strong> shows party (blue = Democrat,
        red = Republican).
      </li>
      <li>
        <strong>The bill selector</strong> at the top of the map switches
        between bills. Picking a Senate bill swaps the map to the 50
        Senate districts; picking a House bill swaps back. The
        &ldquo;Just explore the map&rdquo; option lets you browse without
        a vote choropleth.
      </li>
      <li>
        <strong>Layers panel</strong> (top-left) toggles county /
        municipal boundaries and the other-chamber district lines, and
        lets you highlight a single municipal class (e.g. all 1st-class
        townships — the older 1970s-suburban-boom tier — vs. 2nd-class
        — exurban and rural).
      </li>
      <li>
        <strong>Click a district</strong> to see the member, every
        tracked bill&rsquo;s status for that district, and population /
        municipal context. Hover any municipality (when the muni layer
        is on) for population, density, and class details.
      </li>
    </ul>

    <h2>About the housing data</h2>
    <p>
      The housing-affordability stats shown on every district come
      from public Census data and city open-data portals, with
      district-level numbers derived as follows:
    </p>
    <ul>
      <li>
        <strong>Median income, median home value, rent-burdened %,
        owner-burdened %</strong> &mdash; pulled from the ACS 2023
        5-year survey at the municipality level, then
        population-weighted across the muni areas inside each
        district. ACS suppresses estimates for very small populations;
        those districts display &ldquo;&mdash;.&rdquo;
      </li>
      <li>
        <strong>Permitted housing units per 1,000 residents / year
        (2020-2024)</strong> &mdash; counted from Census Building
        Permits Survey (BPS) annual files for 99% of Pennsylvania
        municipalities. For Philadelphia and Pittsburgh, where the
        city sits inside many state legislative districts, we use
        each city&rsquo;s own geocoded permit data instead so each
        district reflects its actual permitting activity:
        <ul>
          <li>
            <strong>Philadelphia</strong> &mdash; Department of Licenses
            and Inspections (L&amp;I) permits, filtered to new-construction
            housing 2020-2024. Per-permit unit counts are summed by
            point-in-polygon to each House and Senate district.
          </li>
          <li>
            <strong>Pittsburgh</strong> &mdash; Department of Permits,
            Licenses, and Inspections (PLI) data via WPRDC. Because
            Pittsburgh&rsquo;s portal doesn&rsquo;t store unit counts
            per permit, we use the spatial distribution of permits
            across districts to allocate the city&rsquo;s BPS-reported
            5-year unit total.
          </li>
          <li>
            Other municipalities that span multiple state districts
            (Allentown, Reading, Erie, Lancaster, etc.) use
            area-apportionment of the BPS total &mdash; this assumes
            permits are roughly evenly distributed across each
            city&rsquo;s area, which is a known approximation. Of these,
            only Allentown spans more than two House districts, and
            even there the largest slice holds 42% of the city&rsquo;s
            area.
          </li>
        </ul>
      </li>
      <li>
        <strong>Cross-county boroughs and cities</strong> (e.g.
        Bethlehem, which sits in both Lehigh and Northampton counties)
        are reported by BPS under a single county. Their permits are
        redistributed across all county-slices proportional to
        population so the permitting rate is consistent regardless of
        which county side you look at.
      </li>
    </ul>

    <h2>Sources</h2>
    <ul>
      <li>
        Roll calls and bill metadata: palegis.us (linked per bill above).
      </li>
      <li>
        Districts: US Census TIGER/LINE 2024 (state legislative
        districts, lower and upper chambers).
      </li>
      <li>
        Counties &amp; municipalities: US Census TIGER/LINE 2024;
        population from ACS 2023 5-year estimates; municipal class from
        the PA Department of Community &amp; Economic Development
        (dced.pa.gov).
      </li>
      <li>
        Housing-affordability stats:
        ACS 2023 5-year (tables B19013, B25077, B25070, B25091);
        Census Building Permits Survey (BPS) annual files
        2020-2024;
        Philadelphia L&amp;I permits via
        <a href="https://opendataphilly.org/dataset/licenses-and-inspections-building-permits" target="_blank" rel="noopener">OpenDataPhilly</a>;
        Pittsburgh PLI permits via
        <a href="https://data.wprdc.org/dataset/pli-permits" target="_blank" rel="noopener">WPRDC</a>.
      </li>
    </ul>
  </section>
</Layout>
