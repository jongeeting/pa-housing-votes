---
import Layout from "@/layouts/Layout.astro";
import { VoteMap } from "@/components/VoteMap";
import { APRIL_13_2026_ROLL_CALLS } from "@/data/votes/2026-04-13-housing";
const rollCalls = APRIL_13_2026_ROLL_CALLS;
---

<Layout title="PA Housing Votes — April 13, 2026 committee vote">
  <header class="page-header">
    <div class="page-header__inner">
      <p class="page-header__eyebrow">PA Housing Votes</p>
      <h1>How every PA House district voted on zoning reform</h1>
      <p class="page-header__lede">
        On April 13, 2026 the House Housing &amp; Community Development committee
        voted two state zoning reform bills out of committee. Both passed 19&ndash;7
        with bipartisan support. This map shows how each committee member voted
        and which other districts&rsquo; representatives co-sponsored the bills.
      </p>
    </div>
  </header>

  <main class="page-main">
    <VoteMap client:only="react" rollCalls={rollCalls} />
  </main>

  <section class="page-notes">
    <h2>Where the bills stand</h2>
    <p>
      Both bills were reported out of the House Housing &amp; Community
      Development committee as amended on April 13, 2026 and received
      first consideration the same day. They are currently
      <strong>laid on the table</strong> &mdash; parked on the House
      calendar, awaiting a call-up for second consideration and a floor
      vote. The next step is for House leadership to schedule them.
    </p>
    <table class="status-table">
      <thead>
        <tr>
          <th>Bill</th>
          <th>Short title</th>
          <th>Committee vote</th>
          <th>Current status</th>
          <th>Links</th>
        </tr>
      </thead>
      <tbody>
        {rollCalls.map((rc) => (
          <tr>
            <td><strong>{rc.bill.label}</strong></td>
            <td>{rc.bill.shortTitle}</td>
            <td>Passed {rc.totals.yea}&ndash;{rc.totals.nay}</td>
            <td>Laid on the table</td>
            <td>
              <a href={rc.bill.sourceUrl} target="_blank" rel="noopener">Bill info</a>
              {" | "}
              <a href={rc.sourceUrl} target="_blank" rel="noopener">Roll call</a>
              {" | "}
              <a href={`/data/bills/${rc.bill.id}-PN${rc.bill.id === "HB2109" ? "3172" : "3173"}.pdf`} target="_blank" rel="noopener">Full text (PDF)</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Reading the map</h2>
    <ul>
      <li>
        <strong>Fill color</strong> shows how that district&rsquo;s
        representative voted on the selected bill. Green = Yea, orange =
        Nay, purple = cosponsor (not on committee), gray = neither.
      </li>
      <li>
        <strong>Outline color</strong> shows party (blue = Democrat,
        red = Republican). Districts with a colored outline belong to a
        committee member who cast a vote.
      </li>
      <li>
        <strong>Click a district</strong> to see the member, their vote
        on each bill, and the population share covered by the largest
        municipalities and municipal class types.
      </li>
    </ul>

    <h2>Sources</h2>
    <ul>
      {rollCalls.map((rc) => (
        <li>
          {rc.bill.label}: {rc.bill.shortTitle} —
          <a href={rc.bill.sourceUrl} target="_blank" rel="noopener">
            bill info
          </a>{" | "}
          <a href={rc.sourceUrl} target="_blank" rel="noopener">
            roll call
          </a>{" "}
          (palegis.us)
        </li>
      ))}
      <li>
        Districts: US Census TIGER/LINE 2024 (state legislative
        districts, lower chamber).
      </li>
      <li>
        Municipalities: US Census TIGER/LINE 2024 (county subdivisions)
        with population from ACS 2023 5-year estimates.
      </li>
    </ul>
  </section>
</Layout>
