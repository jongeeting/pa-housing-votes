---
import Layout from "@/layouts/Layout.astro";
import { VoteMap } from "@/components/VoteMap";
import { APRIL_13_2026_ROLL_CALLS } from "@/data/votes/2026-04-13-housing";
import { ROLL_CALL_HB2186_FLOOR } from "@/data/votes/2026-05-06-hb2186-floor";

const rollCalls = [...APRIL_13_2026_ROLL_CALLS, ROLL_CALL_HB2186_FLOOR];

interface StatusRow {
  bill: { id: string; label: string; shortTitle: string; sourceUrl?: string; billTextUrl?: string };
  committeeVote: { totals: { yea: number; nay: number }; sourceUrl: string };
  floorVote?: { totals: { yea: number; nay: number }; sourceUrl: string };
  status: string;
}

const statusRows: StatusRow[] = [
  {
    bill: APRIL_13_2026_ROLL_CALLS[0].bill,
    committeeVote: APRIL_13_2026_ROLL_CALLS[0],
    floorVote: ROLL_CALL_HB2186_FLOOR,
    status: "Passed 2nd consideration; awaiting 3rd / final passage",
  },
  {
    bill: APRIL_13_2026_ROLL_CALLS[1].bill,
    committeeVote: APRIL_13_2026_ROLL_CALLS[1],
    status: "Laid on the table; awaiting 2nd consideration",
  },
];
---

<Layout title="PA Housing Votes — Zoning reform tracker">
  <header class="page-header">
    <div class="page-header__inner">
      <p class="page-header__eyebrow">PA Housing Votes</p>
      <h1>How every PA House district voted on zoning reform</h1>
      <p class="page-header__lede">
        On April 13, 2026 the House Housing &amp; Community Development
        committee reported two state zoning reform bills — both 19&ndash;7
        with bipartisan support. On May 6, the ADU bill (HB 2186) cleared
        second consideration on the House floor, 134&ndash;67, with every
        Democrat plus 32 Republicans voting Yea. This map shows how each
        district voted on each bill and which districts&rsquo;
        representatives co-sponsored.
      </p>
    </div>
  </header>

  <main class="page-main">
    <VoteMap client:only="react" rollCalls={rollCalls} />
  </main>

  <section class="page-notes">
    <h2>Where the bills stand</h2>
    <table class="status-table">
      <thead>
        <tr>
          <th>Bill</th>
          <th>Short title</th>
          <th>Committee vote</th>
          <th>Floor vote</th>
          <th>Current status</th>
          <th>Links</th>
        </tr>
      </thead>
      <tbody>
        {statusRows.map((row) => (
          <tr>
            <td><strong>{row.bill.label}</strong></td>
            <td>{row.bill.shortTitle}</td>
            <td>
              <a href={row.committeeVote.sourceUrl} target="_blank" rel="noopener">
                Passed {row.committeeVote.totals.yea}&ndash;{row.committeeVote.totals.nay}
              </a>
            </td>
            <td>
              {row.floorVote ? (
                <a href={row.floorVote.sourceUrl} target="_blank" rel="noopener">
                  Passed {row.floorVote.totals.yea}&ndash;{row.floorVote.totals.nay}
                </a>
              ) : (
                <span class="muted">&mdash;</span>
              )}
            </td>
            <td>{row.status}</td>
            <td>
              <a href={row.bill.sourceUrl} target="_blank" rel="noopener">Bill info</a>
              {row.bill.billTextUrl && (
                <>
                  {" | "}
                  <a href={row.bill.billTextUrl} target="_blank" rel="noopener">Full text (PDF)</a>
                </>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Reading the map</h2>
    <ul>
      <li>
        <strong>Fill color</strong> shows how that district&rsquo;s
        representative voted on the selected bill. Green = Yea, orange =
        Nay, purple = cosponsor (no vote yet on this roll call), gray =
        neither.
      </li>
      <li>
        <strong>Outline color</strong> shows party (blue = Democrat,
        red = Republican).
      </li>
      <li>
        <strong>Click a district</strong> to see the member, their vote
        on each roll call, and the population share covered by the largest
        municipalities and municipal class types.
      </li>
    </ul>

    <h2>Sources</h2>
    <ul>
      {rollCalls.map((rc) => (
        <li>
          {rc.bill.label}: {rc.bill.shortTitle} ({rc.committee ? "committee" : "floor"}, {rc.date}) &mdash;
          <a href={rc.bill.sourceUrl} target="_blank" rel="noopener">
            bill info
          </a>{" | "}
          <a href={rc.sourceUrl} target="_blank" rel="noopener">
            roll call
          </a>{" "}
          (palegis.us)
        </li>
      ))}
      <li>
        Districts: US Census TIGER/LINE 2024 (state legislative
        districts, lower chamber).
      </li>
      <li>
        Municipalities: US Census TIGER/LINE 2024 (county subdivisions)
        with population from ACS 2023 5-year estimates.
      </li>
    </ul>
  </section>
</Layout>
