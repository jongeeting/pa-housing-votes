---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Take Action — PA Housing Votes">
  <header class="page-header">
    <div class="page-header__inner">
      <h1>Take Action</h1>
      <p class="page-header__lede">
        A guided way to contact your representatives about housing
        affordability bills. Coming soon.
      </p>
    </div>
  </header>

  <section class="page-notes">
    <h2>What this page will do</h2>
    <p>
      When this page is finished, clicking the &ldquo;Email your
      rep&rdquo; link inside any district popup will land you here with
      a pre-filled message ready to send. You&rsquo;ll be able to edit
      the message, copy it to your clipboard, or open it in your email
      client with one click.
    </p>
    <p>
      Until then, you can find your state representatives at{" "}
      <a href="https://www.palegis.us/find-my-legislator" target="_blank" rel="noopener">
        palegis.us/find-my-legislator
      </a>.
    </p>
    <p>
      <a href="/">&larr; Back to the map</a>
    </p>
  </section>
</Layout>
