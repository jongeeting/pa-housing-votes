---
/**
 * HB 2186 voting reference memo — internal coalition view.
 *
 * Renders coalition-memos/2026-06-hb2186-voting-reference.md as HTML
 * with maps and charts embedded at section boundaries. Designed to
 * print to PDF nicely (letter size, page-break controls in the
 * print stylesheet at the bottom of this file).
 *
 * The .md file is the single source of truth — regenerated by the
 * Python script that pulls from the roll-call data. The map + chart
 * PNGs live in /coalition-memos/hb2186-assets/ and are regenerated
 * by pipeline/scripts/render_memo_assets.py.
 *
 * The page is marked noindex/nofollow and lives under /coalition/
 * because it's intended for internal Coalition use only. Surface the
 * URL via direct sharing; do not link from anywhere on the public
 * site.
 */
import fs from "node:fs";
import path from "node:path";
import { marked } from "marked";

// Build-time cache-buster mirroring the rest of the site
const BUILD_ID = String(Date.now());
const v = `?v=${BUILD_ID}`;

// Read the canonical markdown file
const memoPath = path.resolve("coalition-memos/2026-06-hb2186-voting-reference.md");
const memoMd = fs.readFileSync(memoPath, "utf-8");

// Configure marked: GFM tables, allow HTML through.
marked.setOptions({
  gfm: true,
  breaks: false,
});

// Per-section visual embeds. Each entry inserts an <img> tag immediately
// AFTER the matching <h2> heading. Keep these synced with section
// numbering in the .md.
const SECTION_VISUALS: Record<string, { src: string; alt: string; caption: string }> = {
  "2. Final Passage caucus breakdown": {
    src: `/coalition-memos/hb2186-assets/chart-caucus.png${v}`,
    alt: "Final Passage caucus breakdown — 139 Yea / 62 Nay. Bar chart.",
    caption:
      "Fig 1. Final Passage tally by caucus. Democrats: 101 of 102 Yea (Borowski the lone D Nay). Republicans: 38 of 99 Yea.",
  },
  "3. Final Passage Yea coalition — by region": {
    src: `/coalition-memos/hb2186-assets/map-final-passage.png${v}`,
    alt: "Map of Pennsylvania showing HB 2186 Final Passage House votes by district. Yea districts are green, Nay districts are terracotta.",
    caption:
      "Fig 2. HB 2186 Final Passage House votes by district. Yea districts shaded green, Nay districts terracotta.",
  },
  "5. Vote changes between 2nd Consideration and Final Passage": {
    src: `/coalition-memos/hb2186-assets/map-vote-change.png${v}`,
    alt: "Map of Pennsylvania highlighting vote shifts between 2nd Consideration and Final Passage. Districts that flipped Nay to Yea are dark blue; districts that flipped Yea to Nay are warm gray.",
    caption:
      "Fig 3. Vote shifts between rc 1054 (May 6) and rc 1075 (June 1). 21 districts moved Nay → Yea; 16 moved Yea → Nay.",
  },
  "6. The reform-interested House Republican universe (53 members)": {
    src: `/coalition-memos/hb2186-assets/map-reform-interested.png${v}`,
    alt: "Map of Pennsylvania highlighting the 53 House Republicans who voted Yea on HB 2186 at least once.",
    caption:
      "Fig 4. The reform-interested House Republican universe. 38 districts held Yea on Final Passage; 15 districts voted Yea on 2nd Consideration only.",
  },
  "7. Muni-class composition of the Yea and Nay coalitions": {
    src: `/coalition-memos/hb2186-assets/chart-muni-class.png${v}`,
    alt: "Stacked bar chart showing the average share of district population by muni class for Yea and Nay coalitions.",
    caption:
      "Fig 5. Muni-class composition of each coalition. 2nd-class township dominates Nay districts at 64% of average population; Yea districts are mixed across all classes.",
  },
  "8. Priority targets for next-round outreach": {
    src: `/coalition-memos/hb2186-assets/map-northern-tier.png${v}`,
    alt: "Map of Pennsylvania highlighting Northern Tier expansion target districts and the rural Republican peer districts who came around between rc 1054 and rc 1075.",
    caption:
      "Fig 6. Northern Tier expansion target districts (gold) alongside rural Republican peer districts who came around between rc 1054 and rc 1075 (green).",
  },
};

// Walk through markdown lines, inject image embeds after relevant h2s.
// We render section-by-section so we can insert HTML in between. Split
// the source on '\n## ' to get section chunks, render each, then
// reassemble with figures interleaved.
const sections = memoMd.split(/\n(?=## )/);

interface RenderedSection {
  html: string;
  visualKey: string | null;
}

const renderedSections: RenderedSection[] = sections.map((sec, i) => {
  // Section 0 is everything before the first ## — render as-is
  if (i === 0) return { html: marked.parse(sec) as string, visualKey: null };
  // Extract the heading text (first line after "## ")
  const firstLine = sec.split("\n", 1)[0]; // "## N. Title..."
  const heading = firstLine.replace(/^## /, "").trim();
  const visualKey = Object.keys(SECTION_VISUALS).find((k) => heading.startsWith(k))
    ?? null;
  return { html: marked.parse(`## ${sec.slice(3)}`) as string, visualKey };
});

// Section 7 gets a second chart embedded later — find it and append.
const SECTION_7_KEY = "7. Muni-class composition of the Yea and Nay coalitions";
const TWP_CHART = {
  src: `/coalition-memos/hb2186-assets/chart-twp-buckets.png${v}`,
  alt: "Bar chart showing Republican Yea rate by 2nd-class township share band, with R caucus baseline at 38%.",
  caption:
    "Fig 7. Republican Yea rate on HB 2186 Final Passage, bucketed by share of district population in 2nd-class townships. Districts in the 50–75% band exceed the R caucus baseline; the 25–50% band runs notably below it.",
};

const today = new Date().toLocaleDateString("en-US", {
  year: "numeric", month: "long", day: "numeric",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <title>HB 2186 Voting Reference — PA Housing Choices Coalition</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="memo">
    <div class="memo__wrap">
      <header class="memo__doc-header">
        <div class="memo__wordmark">PA Housing Votes</div>
        <div class="memo__doc-meta">Internal memo · For PA Housing Choices Coalition</div>
      </header>

      <article class="memo__body">
        {renderedSections.map((sec, i) => (
          <>
            <div set:html={sec.html} />
            {sec.visualKey && (
              <figure class="memo__figure">
                <img
                  src={SECTION_VISUALS[sec.visualKey].src}
                  alt={SECTION_VISUALS[sec.visualKey].alt}
                />
                <figcaption>{SECTION_VISUALS[sec.visualKey].caption}</figcaption>
              </figure>
            )}
            {sec.visualKey === SECTION_7_KEY && (
              <figure class="memo__figure">
                <img src={TWP_CHART.src} alt={TWP_CHART.alt} />
                <figcaption>{TWP_CHART.caption}</figcaption>
              </figure>
            )}
          </>
        ))}
      </article>

      <footer class="memo__doc-footer">
        <p>
          Prepared by PA Housing Votes for the PA Housing Choices Coalition.
          Data current as of the date noted in the document header.
          Rendered {today}.
        </p>
        <p class="memo__doc-footer-meta">
          Live data source: <a href="/">pa-housing-votes.netlify.app</a>.
          Pipeline + data files: github.com/jongeeting/pa-housing-votes.
        </p>
      </footer>
    </div>

    <style is:global>
      /* ---------------------------------------------------------------- *
       * Memo typography + layout — clean institutional, print-ready.
       * Used only by this page; intentionally separate from the rest
       * of the site stylesheet so it can be tuned independently.
       * ---------------------------------------------------------------- */

      :root {
        --memo-fg: #1f2937;
        --memo-fg-muted: #4b5563;
        --memo-fg-faint: #6b7280;
        --memo-bg: #fdfdfc;
        --memo-rule: #d6d3d1;
        --memo-rule-light: #e7e5e4;
        --memo-accent: #4d8d6f;
        --memo-yea: #4d8d6f;
        --memo-nay: #c97b54;
        --memo-page-w: 7.5in;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }
      body.memo {
        background: #f5f5f4;
        color: var(--memo-fg);
        font-family: "Charter", "Iowan Old Style", "Georgia", "Cambria", serif;
        font-size: 11pt;
        line-height: 1.45;
      }

      .memo__wrap {
        max-width: var(--memo-page-w);
        margin: 0 auto;
        padding: 0.6in 0.7in 0.8in;
        background: var(--memo-bg);
        box-shadow: 0 2px 14px rgba(0, 0, 0, 0.06);
      }

      /* Header */
      .memo__doc-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding-bottom: 0.4rem;
        margin-bottom: 1.2rem;
        border-bottom: 2px solid var(--memo-fg);
        font-family: "Inter", "Helvetica Neue", "Arial", sans-serif;
      }
      .memo__wordmark {
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--memo-fg);
      }
      .memo__doc-meta {
        font-size: 0.78rem;
        color: var(--memo-fg-faint);
        letter-spacing: 0.02em;
      }

      /* Body typography */
      .memo__body {
        max-width: 100%;
      }
      .memo__body h1 {
        font-family: "Inter", "Helvetica Neue", "Arial", sans-serif;
        font-size: 1.7rem;
        font-weight: 800;
        line-height: 1.15;
        margin: 0.3rem 0 1rem;
        color: var(--memo-fg);
      }
      .memo__body h2 {
        font-family: "Inter", "Helvetica Neue", "Arial", sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.2;
        margin: 1.6rem 0 0.5rem;
        padding-top: 0.6rem;
        padding-bottom: 0.25rem;
        border-bottom: 1px solid var(--memo-rule);
        color: var(--memo-fg);
        /* Avoid orphaned section headings at the bottom of a page */
        page-break-after: avoid;
        break-after: avoid;
      }
      .memo__body h3 {
        font-family: "Inter", "Helvetica Neue", "Arial", sans-serif;
        font-size: 0.92rem;
        font-weight: 700;
        margin: 0.95rem 0 0.35rem;
        color: var(--memo-fg);
        page-break-after: avoid;
        break-after: avoid;
      }
      .memo__body p,
      .memo__body li {
        font-size: 10.5pt;
        line-height: 1.5;
      }
      .memo__body p {
        margin: 0.45rem 0;
      }
      .memo__body strong {
        color: var(--memo-fg);
      }
      .memo__body a {
        color: var(--memo-accent);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .memo__body em {
        color: var(--memo-fg-muted);
      }
      .memo__body code {
        font-family: "JetBrains Mono", "Menlo", "Consolas", monospace;
        font-size: 0.82em;
        background: #f4f4f5;
        padding: 1px 4px;
        border-radius: 3px;
      }
      .memo__body hr {
        border: 0;
        border-top: 1px solid var(--memo-rule);
        margin: 1.2rem 0;
      }
      .memo__body ul,
      .memo__body ol {
        padding-left: 1.4rem;
        margin: 0.45rem 0;
      }
      .memo__body li + li {
        margin-top: 0.18rem;
      }

      /* Tables */
      .memo__body table {
        width: 100%;
        border-collapse: collapse;
        margin: 0.6rem 0 1rem;
        font-family: "Inter", "Helvetica Neue", "Arial", sans-serif;
        font-size: 9.5pt;
        line-height: 1.35;
        font-variant-numeric: tabular-nums;
      }
      .memo__body thead th {
        text-align: left;
        font-weight: 700;
        background: #f7f6f4;
        padding: 6px 8px;
        border-bottom: 1.5px solid var(--memo-fg);
        color: var(--memo-fg);
      }
      .memo__body tbody td {
        padding: 5px 8px;
        border-bottom: 1px solid var(--memo-rule-light);
        color: var(--memo-fg);
      }
      .memo__body tbody tr:nth-child(even) td {
        background: #fafaf9;
      }
      .memo__body th[align="right"],
      .memo__body td[align="right"] {
        text-align: right;
      }

      /* Figures */
      .memo__figure {
        margin: 1rem 0 1.4rem;
        page-break-inside: avoid;
        break-inside: avoid;
      }
      .memo__figure img {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--memo-rule-light);
        border-radius: 2px;
      }
      .memo__figure figcaption {
        font-family: "Inter", "Helvetica Neue", "Arial", sans-serif;
        font-size: 8.8pt;
        color: var(--memo-fg-muted);
        margin-top: 0.35rem;
        line-height: 1.4;
      }

      /* Footer */
      .memo__doc-footer {
        margin-top: 2rem;
        padding-top: 0.6rem;
        border-top: 1px solid var(--memo-rule);
        font-family: "Inter", "Helvetica Neue", "Arial", sans-serif;
        font-size: 8.5pt;
        color: var(--memo-fg-faint);
      }
      .memo__doc-footer p {
        margin: 0.25rem 0;
      }
      .memo__doc-footer a {
        color: var(--memo-fg-muted);
      }

      /* ---------------------------------------------------------------- *
       * Mobile / narrow-viewport cleanup.
       * The default layout above is letter-portrait tuned (0.7in side
       * padding, 11pt body). On narrow screens that becomes cramped
       * and the doc header wraps awkwardly. These tweaks ease the
       * padding, bump the body font to a comfortable reading size,
       * stack the header, and let wide tables scroll horizontally
       * instead of crushing into the viewport.
       * ---------------------------------------------------------------- */

      @media (max-width: 720px) {
        body.memo {
          font-size: 16px;
          line-height: 1.5;
        }
        .memo__wrap {
          padding: 18px 16px 24px;
          box-shadow: none;
        }
        .memo__doc-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.2rem;
          padding-bottom: 0.5rem;
          margin-bottom: 1rem;
        }
        .memo__wordmark { font-size: 0.85rem; }
        .memo__doc-meta { font-size: 0.78rem; }

        .memo__body h1 { font-size: 1.5rem; }
        .memo__body h2 { font-size: 1.1rem; margin: 1.3rem 0 0.5rem; }
        .memo__body h3 { font-size: 1rem; }
        .memo__body p,
        .memo__body li {
          font-size: 1rem;
          line-height: 1.55;
        }

        /* Let wide tables scroll horizontally instead of overflowing
           the viewport. Wrap them in a scroll container via the parent
           rule below. */
        .memo__body table {
          font-size: 0.85rem;
          display: block;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          white-space: nowrap;
        }
        .memo__body thead th,
        .memo__body tbody td {
          padding: 6px 10px;
        }

        .memo__figure { margin: 0.9rem -2px 1.2rem; }
        .memo__figure figcaption {
          font-size: 0.78rem;
          padding: 0 2px;
        }

        .memo__doc-footer {
          margin-top: 1.5rem;
          font-size: 0.72rem;
        }
      }

      /* ---------------------------------------------------------------- *
       * Print stylesheet — browser print-to-PDF on letter paper.
       * ---------------------------------------------------------------- */

      @media print {
        @page {
          size: letter portrait;
          margin: 0.55in 0.6in 0.6in;
        }
        body.memo {
          background: white;
        }
        .memo__wrap {
          max-width: 100%;
          margin: 0;
          padding: 0;
          box-shadow: none;
          background: white;
        }
        .memo__body h2 {
          page-break-before: auto;
          break-before: auto;
        }
        .memo__body table {
          page-break-inside: auto;
          break-inside: auto;
        }
        .memo__body table tr {
          page-break-inside: avoid;
          break-inside: avoid;
        }
        .memo__body table thead {
          display: table-header-group;
        }
        .memo__figure,
        .memo__figure img {
          page-break-inside: avoid;
          break-inside: avoid;
        }
        a {
          color: inherit !important;
          text-decoration: none !important;
        }
      }
    </style>
  </body>
</html>
