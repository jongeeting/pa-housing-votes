# Census Bureau API key — required for ACS data fetches in the pipeline.
# Free, instant signup at https://api.census.gov/data/key_signup.html.
# After signup, Census emails you the key plus an activation link;
# click that link before trying to use the key.
#
# Copy this file to .env (gitignored) and fill in your key:
#   cp .env.example .env
#   # then edit .env and add your key
# Or export it in your shell directly:
#   export CENSUS_API_KEY=...
CENSUS_API_KEY=
